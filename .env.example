# Copy this file to .env and adjust values for your machine.
# .env is git-ignored; never commit real credentials.

# PostgreSQL container (docker-compose.yml)
# If you change these, also override the app's connection when running it
# outside Docker (SPRING_DATASOURCE_URL / _USERNAME / _PASSWORD), because
# application-dev.yml uses the defaults below.
POSTGRES_DB=tps
POSTGRES_USER=tps
POSTGRES_PASSWORD=tps_local_password
POSTGRES_PORT=5432

# Backend container (docker compose --profile app up)
BACKEND_PORT=8080

# Security of the backend container (prod profile). These are the throwaway local
# values from application-dev.yml; any real deployment needs its own:
#   - JWT signing key, Base64, at least 32 bytes: openssl rand -base64 32
#   - first administrator, created only when the database has no users
TPS_SECURITY_JWT_SECRET=RAP/a0KHL10XXuMCpI2NJGvurrdPGLuXr75mUWH84iE=
TPS_SECURITY_BOOTSTRAP_ADMIN_USERNAME=admin
TPS_SECURITY_BOOTSTRAP_ADMIN_PASSWORD=admin-local-password
